# Copy to .env (pnpm prep does, and fills what it can). Never commit .env.
# Your own account, the one you play on: clips are of this player.
STEAM_ID64=
# A second account, never your main: CS2 is launched on it with HLAE while clips render.
RENDER_STEAM_ID64=
# Tool paths; pnpm prep fills them (HLAE in tools/hlae, CS2 from the Steam library).
HLAE_EXE=
CS2_EXE=
# Optional: FACEIT Data API key for pnpm grab (demos also arrive through Downloads and CS2's folder).
FACEIT_API_KEY=
# Valve matchmaking fetch (main account's match-history auth code, a known share code, Steam Web API key).
# Matches after STEAM_LAST_SHARE_CODE are fetched, not that one.
STEAM_WEB_API_KEY=
STEAM_MATCH_AUTH_CODE=
STEAM_LAST_SHARE_CODE=
